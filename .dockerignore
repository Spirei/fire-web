# 依赖 / 构建产物（构建阶段在容器内重新安装与生成）
node_modules
.next
.next-dev

# 运行期数据与上传（由 volume 挂载）；仅公开展示缓存作为镜像种子。
data/*
!data/duan-posts.json
!data/trump-posts.json
!data/trump-translations.json
!data/top-stocks-cache.json
!data/asset-quotes-cache.json
!data/celebs-cache.json
!data/earnings-cache/
!data/earnings-cache/*.json
# 基础素材库图标、站点形象与名人默认头像打进镜像（新用户开箱即用）
public/uploads/*
!public/uploads/asset
!public/uploads/celebs
!public/uploads/currency
!public/uploads/ico
!public/uploads/login
!public/uploads/logo
!public/uploads/background
# 卡面素材（313MB）：不进镜像，部署后手动放到宿主机 uploads 目录（compose 挂载到 /app/public/uploads）
public/uploads/cards
# 分组图标是用户自定义（自选股分组），不进镜像
public/uploads/asset/group
# 用户数据：头像、上传的财报附件，不进镜像
public/uploads/avatar
public/uploads/reports
dist

# 版本控制 / 本地
.git
.gitignore

# 本地环境（含密钥），不进镜像
.env
.env.local
.env.*.local
VERSIONS.md

# 系统 / 编辑器杂项
.DS_Store
*.log
pm2*.log
.npm

# 开发 / 设计稿产物：不进镜像
public/mockups
public/fire
public/fire-planner-preview.html
public/settings-mockup-standard.html

public/uploads/**
!public/uploads/.gitkeep
# 例外：四色门侧栏运行必需的 4 个素材（窗户 / 转盘 / 指针 / 手型光标）。
# 随镜像进入 /app/resource-default，由 entrypoint 播种到 uploads 卷；其余上传素材仍由部署者提供。
!public/uploads/feature/four-door/window.png
!public/uploads/feature/four-door/dial.png
!public/uploads/feature/four-door/pointer.png
!public/uploads/feature/four-door/cursor-hand.png
public/*preview*.html

public/fonts
public/images
public/share
public/icons
public/maps-world.json

app/favicon.ico
