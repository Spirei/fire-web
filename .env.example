# 配套 docker-compose.ghcr.yml；填写后保存为同目录 .env。

# 镜像与目录
GHCR_IMAGE=ghcr.io/replace-owner/fire-web
HOST_PORT=3000
FIRE_NETWORK=
FIRE_PRIVATE_DIR=./fire-private
DOCKER_CONFIG_DIR=/REPLACE/docker-config

# 访问与数据库
FIRE_PUBLIC_ORIGIN=https://fire.example.invalid
FIRE_ENVIRONMENT=staging
FIRE_INSTANCE_ID=
FIRE_DATABASE_URL=
FIRE_REDIS_URL=

# production 首次创建管理员时填写，至少 32 字符；其他环境留空。
FIRE_SETUP_TOKEN=

FIRE_WORKER=on

# 可选：固定 Yahoo 行情出口使用现有 HTTP 代理；默认直连。
# 示例：STOCKLOG_PROXY=http://proxy-host:8080；保存后重建容器。
# 保留目标公网 IP、原主机 TLS 校验；不代理富途、汇率和自定义接口。
STOCKLOG_PROXY=off

# 更新器
WATCHTOWER_HTTP_API_TOKEN=

# 网页发版时填写；仅自动更新可留空。
FIRE_DEPLOYMENT_GITHUB_TOKEN=
