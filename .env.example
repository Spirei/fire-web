# 仅在生产环境首次创建空数据库时使用；密码需 8-128 位且同时包含字母和数字。
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# 可选：邮箱找回密码。也可登录后在“设置 → 数据与系统 → 邮件服务”中配置；网页配置优先。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Alcor
SMTP_FROM_EMAIL=

# 使用 docker-compose.ghcr.yml 时必填；替换为你自己的 GHCR 镜像。
GHCR_IMAGE=ghcr.io/your-github-name/fire-web
IMAGE_TAG=latest

# 可选：宿主机端口及持久化目录，默认均可直接使用。
HOST_PORT=3000
DATA_DIR=./data
UPLOADS_DIR=./uploads

# 可选：服务端出站代理；默认关闭，需要时填写完整代理地址。
STOCKLOG_PROXY=off
# 排查代理时设为 1，打印每条请求走代理还是直连（默认静默）。
STOCKLOG_PROXY_DEBUG=
# 富途 OpenD：生产默认按设置连接。本地 next dev 默认跳过，避免抢线上唯一连接；
# 需要本机连 OpenD 时设为 on。off 则任何环境都不连。
STOCKLOG_FUTU=
# 美股扩展时段兜底：默认 yahoo。设为 off 则只用腾讯常规盘（配合界面「腾讯兜底」提示）。
STOCKLOG_EXTENDED_QUOTE=yahoo

# 可选：发布状态页读取并手动触发 GitHub Actions 时使用 fine-grained token。
# 公开仓库读取状态无需填写；如需网页“立即推送”，请授予目标仓库 Actions: Read and write 权限，不要提交到 Git。
GITHUB_REPOSITORY=owner/repository
GITHUB_TOKEN=
# 可选：启用网页“GitHub 授权登录”（OAuth App）。从公网 HTTPS 域名访问，
# 回调地址须与 GitHub OAuth App 中登记的地址一致；留空时使用站点域名（或邮件链接地址）。
# 示例：https://fire.example.com/api/deploy-status/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
# 用于加密网页保存的 OAuth / 备用 Token（至少 16 位，务必长期保持不变）
DEPLOY_STATUS_SECRET=

# 群晖 GHCR 一键更新：生成命令 `openssl rand -hex 32`。
# 仅供 Alcor 容器在 Compose 内网调用 Watchtower，请勿映射 Watchtower 的 8080 端口。
WATCHTOWER_HTTP_API_TOKEN=
# docker login ghcr.io 生成的配置目录；群晖 root 登录默认无需修改。
DOCKER_CONFIG_DIR=/root/.docker

# 可选：DeepSeek 视觉识别（截图导入优先走云端 OCR，未配置自动回退本地 Apple Vision）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# 可选：卡面库中英对照表生成脚本（scripts/gen-card-en.mjs）用的文本模型。
# 有 DEEPSEEK_API_KEY 就直接用它；没配时退回这里的 DashScope 兼容接口。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_MODEL=qwen-plus

# First administrator registration in production requires this deployment secret (32+ characters).
FIRE_SETUP_TOKEN=

# 仅当应用位于会清洗并重写 X-Forwarded-For / X-Real-IP 的可信反向代理后方时开启。
# 直连或无法确认代理行为时保持关闭，防止客户端伪造 IP 绕过登录限流。
FIRE_TRUST_PROXY_HEADERS=false

# 原生 Alcor App 网页授权使用的公网 HTTPS 源（含非默认端口）。
# 留空时读取网站设置中的域名；域名迁移时同步修改，App 更换服务器后重新授权。
# FIRE_APP_ORIGIN=https://fire.example.com:18520
FIRE_APP_ORIGIN=

# 可选：动态的全网搜索。只在服务端使用，不回传 App/网页；留空时用 Google News RSS 新闻检索。
# 动态提炼与讨论复用「设置 → 模型服务」中的服务。
BRAVE_SEARCH_API_KEY=

# 可选：本地开发环境也按已保存指示自动生成动态（会使用模型服务）；生产默认启用。
FIRE_FEED_SCHEDULER=0
