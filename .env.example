# Fire 单一平台配置；复制为未提交的 .env.local（本地）或 Compose 同目录 .env。
# 首次部署前完成数据库、身份和备份核对；运行命令不会自动初始化或迁移数据库。

# 镜像与宿主机目录。GHCR_IMAGE 不含标签；HOST_PORT 可修改。
GHCR_IMAGE=ghcr.io/replace-owner/fire-web
IMAGE_TAG=latest
HOST_PORT=3000
FIRE_NETWORK=
FIRE_PRIVATE_DIR=./fire-private
UPLOADS_DIR=./uploads
IMAGES_DIR=./images
FONTS_DIR=./fonts
ICONS_DIR=./icons
SHARE_DIR=./share
DOCKER_CONFIG_DIR=/REPLACE/docker-config

# 必填：实际访问源及数据库身份，更新时保持原 UUID。
# PG、Redis 以这里为唯一连接来源；管理页面只展示脱敏信息和测试，不在线保存覆盖。
FIRE_PUBLIC_ORIGIN=https://fire.example.invalid
FIRE_ENVIRONMENT=staging
# 不填写全零 UUID，不从另一个实例照抄。先用 npm run platform:inspect 只读核对。
# 已登记库读取 instance_id；无标识且非空的旧库必须先核对迁移方案，不能直接初始化。
# 首次空库：确定新 UUID 后写入本项，再显式初始化；填写 UUID 本身不会修改数据库。
FIRE_INSTANCE_ID=
# 格式：postgresql://USER:URL_ENCODED_PASSWORD@PG_CONTAINER:5432/DATABASE
FIRE_DATABASE_URL=
# 可选：独立 Redis ACL 及缓存范围；留空时显示未配置，不伪造连接状态。
FIRE_REDIS_URL=

# 镜像已内置 FIRE_PG_TOOLS_DIR；本地联合备份可另设匹配的 PG 工具目录。
# 本地 Python；Compose 使用镜像内 Python。端口可由命令 --port 覆盖。
FIRE_PYTHON=./platform/.venv/bin/python
PORT=3000
FIRE_WORKER=on
# 本地路径；Compose 固定映射为 /private 下的同名独立目录。
FIRE_CONNECTION_SECRET_DIR=./fire-private/state/connection-secrets
FIRE_FILE_ROOT=./fire-private/files
FIRE_ASSET_ROOT=./fire-private/assets
FIRE_BACKUP_DIR=./fire-private/backups
FIRE_BACKUP_SECRET_DIR=./fire-private/backup-key

# 默认参数通常无需修改。环境标记不会隔离数据库，必须与库中登记一致。
FIRE_POOL_SIZE=5
FIRE_POOL_MIN_SIZE=0
FIRE_CONNECT_TIMEOUT=3
FIRE_WORKER_POLL_SECONDS=1
FIRE_LEASE_SECONDS=30
FIRE_SESSION_HOURS=24
# 联合备份总量、原件数量、磁盘保留量和执行时间预算。
FIRE_BACKUP_STREAM_MAX_BYTES=2147483648
FIRE_BACKUP_STREAM_MAX_OBJECTS=10000
FIRE_BACKUP_STREAM_DISK_RESERVE_BYTES=268435456
FIRE_BACKUP_STREAM_SECONDS=1800
# 仅供读取历史小型备份的容量预算。
FIRE_BACKUP_MAX_BYTES=67108864
# 恢复只允许预登记隔离目标，默认不启用恢复。
FIRE_RESTORE_TARGETS=[]

# 身份邮件由 Worker 投递。关闭时无需填写 SMTP；开启时必须有有效 TLS 配置。
FIRE_MAIL_ENABLED=false
FIRE_MAIL_HOST=
FIRE_MAIL_PORT=587
FIRE_MAIL_TLS=starttls
FIRE_MAIL_SENDER=
FIRE_MAIL_FROM_NAME=
FIRE_MAIL_USERNAME=
FIRE_MAIL_PASSWORD=
FIRE_MAIL_TIMEOUT=10
# 出站邮件网络策略默认拒绝；启用前配置自己的精确目标和允许地址。
FIRE_MAIL_DELIVERY_POLICY={}

# 网页更新：默认从 GHCR_IMAGE 推导仓库/镜像；自定义时须同时设置下两项。
FIRE_DEPLOYMENT_REPOSITORY=
FIRE_DEPLOYMENT_IMAGE=
FIRE_DEPLOYMENT_GITHUB_TOKEN=
# Compose 将以下独立令牌只传给 Fire 的更新调用和受限更新器。
WATCHTOWER_HTTP_API_TOKEN=
# 本地不使用更新器时留空；Compose 使用 fire-updater 私网地址。
FIRE_DEPLOYMENT_UPDATER_URL=
FIRE_DEPLOYMENT_RUNNER_TOKEN=
# 可选 GitHub OAuth App；回调为 PUBLIC_ORIGIN + /api/deployment/github/callback。
FIRE_DEPLOYMENT_GITHUB_CLIENT_ID=
FIRE_DEPLOYMENT_GITHUB_CLIENT_SECRET=
# 构建版本和提交由镜像写入，不手工填写软件版本、buildSha 或运行 digest。

# 外部汇率目标默认不放行；其他高级功能按自身配置和精确网络策略启用。
FIRE_FX_PROVIDER_TARGETS=[]
# Fire 内置后端使用私有 socket，不沿用独立 API 的反向代理 IP 白名单。
