# 仅在生产环境首次创建空数据库时使用；密码需 8-128 位且同时包含字母和数字。
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# 使用 docker-compose.ghcr.yml 时必填；替换为你自己的 GHCR 镜像。
GHCR_IMAGE=ghcr.io/your-github-name/fire-web
IMAGE_TAG=latest

# 可选：宿主机端口及持久化目录，默认均可直接使用。
HOST_PORT=3000
DATA_DIR=./data
UPLOADS_DIR=./uploads

# 可选：服务端出站代理；默认关闭，需要时填写完整代理地址。
STOCKLOG_PROXY=off

# 可选：DeepSeek 视觉识别（截图导入优先走云端 OCR，未配置自动回退本地 Apple Vision）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
