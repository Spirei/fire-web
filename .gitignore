# User-generated uploads (default assets remain tracked)
public/uploads/avatar/
public/uploads/reports/
public/uploads/trading-square/
# 卡面素材（313MB / 460+ 个文件）：不进 Git、也不进镜像，
# 部署时手动放到服务器的 uploads 目录（compose 把 UPLOADS_DIR 挂到 /app/public/uploads）
public/uploads/cards/

# Deployment media is supplied by deployers; never redistribute it.
/public/uploads/*
!/public/uploads/.gitkeep
# 例外：四色门侧栏运行必需的 4 个素材（窗户 / 转盘 / 指针 / 手型光标）。
# 缺任意一个，侧栏入口会先闪烁再整块消失；体积极小，已获准随公开仓库分发。
!/public/uploads/feature/
!/public/uploads/feature/four-door/
/public/uploads/feature/four-door/*
!/public/uploads/feature/four-door/window.png
!/public/uploads/feature/four-door/dial.png
!/public/uploads/feature/four-door/pointer.png
!/public/uploads/feature/four-door/cursor-hand.png
