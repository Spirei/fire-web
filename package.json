{
  "name": "alcor",
  "version": "0.1.77",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-system-media.mjs && node scripts/generate-api-request-routes.mjs",
    "dev": "node scripts/fire.mjs dev",
    "prebuild": "node scripts/prepare-system-media.mjs && node scripts/generate-api-request-routes.mjs && node scripts/generate-platform-releases.cjs",
    "build": "next build",
    "start": "node scripts/fire.mjs start",
    "audit:public": "node scripts/audit-public-repo.mjs",
    "audit:deploy": "node scripts/audit-deploy-parity.mjs",
    "check:commit-title": "node scripts/check-commit-title.mjs",
    "smoke": "bash scripts/smoke-test.sh",
    "smoke:ci": "bash scripts/smoke-ci.sh",
    "backup:source": "python3 scripts/backup-project.py",
    "test:source-backup": "python3 tests/source-backup.py",
    "test:review": "node scripts/test-review.mjs",
    "check:quick": "node scripts/check-quick.mjs",
    "clean:caches": "node scripts/clean-next-cache.mjs",
    "clean:dsstore": "find .. -name .DS_Store -not -path '*/node_modules/*' -delete && echo '已清理 .DS_Store'",
    "test:platform": "node tests/platform-gateway.cjs && node tests/platform-navigation.cjs && node tests/system-refresh.cjs",
    "test:backend": "node scripts/fire.mjs test-backend",
    "platform:config": "node scripts/fire.mjs validate-config",
    "platform:inspect": "node scripts/fire.mjs inspect-database",
    "platform:check": "node scripts/fire.mjs check-schema",
    "platform:migrate": "node scripts/fire.mjs migrate",
    "dev:pm2": "node scripts/pm2-dev.mjs",
    "test:controls": "node tests/shared-controls.cjs && node tests/popover-interactions.cjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@tabler/icons-react": "^3.46.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "next": "15.5.29",
    "pinyin-match": "^1.2.10",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-photo-view": "^1.2.7",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "esbuild": "0.28.2",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.5",
    "uuid": "11.1.1",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "6.1.5"
  }
}
